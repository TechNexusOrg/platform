# Server Environment Variables
NODE_ENV=development
APP_URL=http://localhost:3000

# Authentication & Session Security (AES-256 secret, min 32 chars)
AUTH_SECRET=changeme_in_production_min_32_characters_long_secret_key_123

# GitHub OAuth App Credentials
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Optional: GitHub Personal Access Token or App Token for elevated rate limits when querying TechNexusOrg
GITHUB_ACCESS_TOKEN=

# Database Connection (PostgreSQL)
# e.g., postgresql://user:password@localhost:5432/technexus
# If left empty in development/testing, platform falls back to embedded PGlite
DATABASE_URL=

# GitHub Webhook Secret (for verifying incoming webhooks from TechNexusOrg repositories)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_key

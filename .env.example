# ==============================================================================
# TechNexusOrg Platform Environment Configuration Example
# Copy this file to .env or .env.local for local development.
# In production, all secrets must be strong, randomly generated, and unique.
# ==============================================================================

# Application Runtime
NODE_ENV=development
APP_URL=http://localhost:3000

# Authentication & Session Security (Min 32 characters, randomly generated)
# Generate with: openssl rand -base64 32
AUTH_SECRET=development_secret_key_strictly_for_local_testing_min_32_chars

# Internal Automation & Service-to-Service Secret (Min 32 characters)
# Used for backend cron sync jobs and service-level operations
# Generate with: openssl rand -base64 32
INTERNAL_SERVICE_SECRET=dev_internal_service_key_strictly_for_local_testing_min_32_chars

# GitHub OAuth Application Credentials
# Register at: https://github.com/settings/developers
# Callback URL: <APP_URL>/api/auth/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Optional: GitHub Access Token for elevated API rate limits on repository sync
GITHUB_ACCESS_TOKEN=

# GitHub Webhook HMAC Secret
# Configured in TechNexusOrg organization webhook settings
# Payload URL: <APP_URL>/api/webhooks/github
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_key

# PostgreSQL Database Connection URL
# Mandatory in production. Format: postgresql://username:password@hostname:5432/database_name
# If left unset in development/test, platform uses embedded PGlite
DATABASE_URL=

# Organization Trust Boundary (Defaults to official TechNexusOrg GitHub Org)
TECH_NEXUS_ORG_ID=333899669
TECH_NEXUS_ORG_NAME=TechNexusOrg
